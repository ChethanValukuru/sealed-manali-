# Copy to .env and adjust. Compose reads these.

# Model backend. Set MOCK_MODEL=1 to run the full eval loop WITHOUT pulling an
# Ollama model (deterministic canned responses). Set to 0 to use real Ollama.
MOCK_MODEL=1
OLLAMA_HOST=http://host.containers.internal:11434
OLLAMA_MODEL=llama3.2:1b

# Response timing normalization quantum in ms (Phase 4 / M5). 0 = off.
# Set e.g. 50 to pad every broker response to a 50ms boundary (mitigates, does
# NOT eliminate, timing side channels). The latency report measures the cost.
TIMING_QUANTUM_MS=0

# Capability tokens (Phase 4 / M5). Each tenant holds ONLY its own token; the
# broker holds all three. Dev defaults are baked into compose — override here
# with real secrets for anything beyond a local demo.
RED_TOKEN=red-cap-token-dev
BLUE_TOKEN=blue-cap-token-dev
MODEL_TOKEN=model-cap-token-dev
